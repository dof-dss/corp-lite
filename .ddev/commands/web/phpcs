#!/usr/bin/env bash

## Description: Execute local PHPCS static analysis checks.
## Usage: phpcs [directories]
## Example: "ddev phpcs" or "ddev phpcs web/modules/custom"
## HostWorkingDir: true

DRUPAL_DEPLOY_PATH="/var/www/html"
IGNORE="web/themes/origins/node_modules web/themes/custom/nicsdru_corplite_theme/node_modules"

# Check the requested directories, or the current directory by default.
PHPCS_CHECK_DIRS="${*:-.}"

"${DRUPAL_DEPLOY_PATH}/phpcs.sh" "${DRUPAL_DEPLOY_PATH}" "${PHPCS_CHECK_DIRS}" "${IGNORE}"
